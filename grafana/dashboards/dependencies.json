          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Waiting on locks (orders DB)",
      "description": "Active backends; a rise with flat throughput suggests sessions waiting on locks.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_activity_count{datname=\"orders\", state=\"active\"})",
          "refId": "A",
          "legendFormat": "active backends"
